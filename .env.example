# Copy to .env and fill in. Never commit .env.

# --- Telegram bot (from @BotFather) ---
BOT_TOKEN=
# Private mode: comma-separated Telegram user ids allowed to use the bot.
# Leave empty to make the bot public.
ALLOWED_USER_IDS=

# --- Telegram reader account (https://my.telegram.org -> API development tools) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/reader.session
# Comma-separated group usernames or t.me links, e.g. cyprus_market,https://t.me/limassol_sale
TELEGRAM_GROUPS=
TELEGRAM_BACKFILL_DAYS=30

# --- LLM query expansion (optional; a rule-based fallback is used without a key) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Database ---
# docker-compose overrides the host to `postgres`; this is for running on the host.
DATABASE_URL=postgresql+asyncpg://aggregator:aggregator@localhost:5432/aggregator

# --- Sources ---
ENABLED_SOURCES=bazaraki,telegram
ENABLE_FACEBOOK_MARKETPLACE=false
BAZARAKI_CACHE_TTL_SECONDS=300

# --- Listings / analytics ---
LISTING_MAX_AGE_DAYS=30
BEST_DEAL_RATIO=0.75
# Show the "Best deals" block in results (off until relevance tuning is better)
SHOW_BEST_DEALS=false
RELEVANCE_MIN_SCORE=0.75
MAX_QUERY_LENGTH=100
RESULT_SESSION_TTL_SECONDS=3600

# --- Rate limiting (off by default in private mode) ---
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Runtime ---
LOG_LEVEL=INFO
LOG_JSON=true
HEALTH_PORT=8080
